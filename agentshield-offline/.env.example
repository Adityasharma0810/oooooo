# AgentShield Offline — Environment Variable Configuration
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to version control.

# ---- Application ----
AGENTSHIELD_ENVIRONMENT=development
AGENTSHIELD_DEBUG=false
AGENTSHIELD_API_HOST=0.0.0.0
AGENTSHIELD_API_PORT=8001

# ---- API Authentication ----
# Replace this with a strong random key in staging/production
AGENTSHIELD_DEV_API_KEY=dev-offline-insecure-key-change-me

# ---- ClamAV ----
AGENTSHIELD_CLAMAV_HOST=localhost
AGENTSHIELD_CLAMAV_PORT=3310
AGENTSHIELD_CLAMAV_TIMEOUT=30
AGENTSHIELD_CLAMAV_FAIL_CLOSED=true

# ---- Docker Sandbox ----
AGENTSHIELD_SANDBOX_IMAGE=python:3.11-slim
AGENTSHIELD_SANDBOX_MEMORY_LIMIT=256m
AGENTSHIELD_SANDBOX_NETWORK_MODE=none
AGENTSHIELD_SANDBOX_DEFAULT_TIMEOUT=30
AGENTSHIELD_SANDBOX_ENABLED=true

# ---- Workspace ----
AGENTSHIELD_DEFAULT_WORKSPACE=/workspace

# ---- Quarantine ----
AGENTSHIELD_QUARANTINE_DIR=/var/agentshield/quarantine

# ---- Audit ----
AGENTSHIELD_AUDIT_LOG_PATH=/var/log/agentshield/audit.jsonl
AGENTSHIELD_AUDIT_FAIL_OPEN=false

# ---- Inspection ----
AGENTSHIELD_INSPECTION_FAIL_CLOSED=true

# ---- Document Limits ----
AGENTSHIELD_DOCUMENT_MAX_SIZE_BYTES=52428800
AGENTSHIELD_DOCUMENT_MAX_PAGES=500
AGENTSHIELD_DOCUMENT_PROCESSING_TIMEOUT=60

# ---- NeMo Guardrails (optional) ----
# Install first: pip install -e ".[nemo]"
AGENTSHIELD_NEMO_ENABLED=false
AGENTSHIELD_NEMO_PROFILE=local
# Path to the NeMo config directory (default: configs/nemo)
# AGENTSHIELD_NEMO_CONFIG_PATH=configs/nemo
AGENTSHIELD_NEMO_TIMEOUT=30
AGENTSHIELD_NEMO_FAIL_CLOSED=true
AGENTSHIELD_NEMO_INSPECT_DOCUMENTS=true
AGENTSHIELD_NEMO_INSPECT_TERMINAL_OUTPUT=true
AGENTSHIELD_NEMO_MAX_CONTENT_CHARS=50000
AGENTSHIELD_NEMO_TELEMETRY_DISABLED=true

# For model_backed / production profiles only — never commit these values:
# OPENAI_API_KEY=sk-...
# NEMO_LLM_BASE_URL=http://your-local-inference-server/v1
